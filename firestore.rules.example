rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read for published news only
    match /news/{postId} {
      allow read: if resource.data.isPublished == true;
      allow write: if request.auth != null;
    }

    // Staff list — public read, auth write
    match /staff/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery metadata — public read, auth write
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admissions — anyone can create (enquiry form), only auth can read/update
    match /admissions/{appId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // School settings — public read, auth write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
