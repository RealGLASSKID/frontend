rules_version = '2';

// IMPORTANT CONTEXT — READ BEFORE DEPLOYING
//
// The admin panel uses a hardcoded client-side check (username "admin",
// password "admin123") instead of real Firebase Authentication. Firestore
// rules have no way to verify that check — they can only see whether a
// Firebase Auth session exists at all (`request.auth != null`), not who
// it belongs to.
//
// For these rules to work as intended, the admin login flow must also
// call `signInAnonymously()` from the Firebase Auth SDK the moment the
// hardcoded admin/admin123 check succeeds (and `signOut()` on sign out).
// See lib/firebase-auth-bridge.ts.
//
// This is a soft speed bump, not real security: anyone who opens browser
// dev tools and calls `signInAnonymously()` themselves against your
// Firebase project gets the same write access these rules grant. It stops
// casual/opportunistic writes from a fully anonymous request, but it does
// NOT stop a determined visitor. If you need real protection, switch the
// login to actual Firebase Authentication (email/password) so rules can
// check a specific identity instead of "any session."

service cloud.firestore {
  match /databases/{database}/documents {

    // News: public can read only published posts; any authenticated
    // (anonymous-or-not) session can read/write everything, matching the
    // admin panel's own draft/publish workflow.
    match /news/{postId} {
      allow read: if resource.data.isPublished == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Staff: public directory, read-only for visitors.
    match /staff/{staffId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Gallery: public read (it's meant to be shown on the site), admin-only writes.
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admissions: the public admission form creates applications directly
    // (no login), but can never read the list back or edit/delete entries.
    // Only an authenticated admin session can read, update status, or delete.
    match /admissions/{applicationId} {
      allow create: if request.resource.data.status == "pending";
      allow read, update, delete: if request.auth != null;
    }

    // Settings: public read (school name/contact info shown on the site),
    // admin-only writes.
    match /settings/{documentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
